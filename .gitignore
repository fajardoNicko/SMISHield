# Research documents stay local and are not versioned
Manuscript Files/

# Python
__pycache__/
*.pyc
.venv/

# Generated training reports (re-create with: python ml/train.py)
ml/reports/

# Downloaded source files (re-download from Kaggle; see ml/data/README.md)
ml/data/raw/

# VCSMS student submissions and anything labelled from them. This repository
# is PUBLIC: research-team-only data must never be committed.
ml/data/private/

# Annotation workbooks are shared within the team, not versioned
ml/annotation/

# The team's working folder (filled-in workbooks, VCSMS submissions). The
# leading slash matters: on Windows "Data/" would also match ml/data/.
/Data/

# OS / editors
.DS_Store
Thumbs.db

# Built APKs to share, and rendered screen previews (re-create: see app/README.md)
/dist/
app/screenshots/shots/
